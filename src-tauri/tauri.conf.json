{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Studio 3D",
  "version": "0.1.0",
  "identifier": "com.alvorland.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Asset Studio 3D", "width": 1400, "height": 880, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
